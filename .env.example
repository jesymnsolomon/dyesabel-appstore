# Copy this file to .env and fill in your Supabase project values.
# Leave them empty to run Splitsy in Demo mode (data saved on this device only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode only: comma-separated emails that get the superadmin dashboard
# (with Supabase, superadmins are set in the splitsy_admins table instead)
VITE_SPLITSY_ADMIN_EMAILS=

# Phone push notifications: the PUBLIC key from `npx web-push generate-vapid-keys`
# (the private key goes in Supabase → Edge Functions → Secrets, never here)
VITE_VAPID_PUBLIC_KEY=
